
# ─────────────────────────────────────────────────────────────
# Google reviews (Google Places API — New)
# ─────────────────────────────────────────────────────────────
# The testimonials sections pull live reviews from the GROUTIX Google Business
# Profile. If these are left blank, the site falls back to curated reviews.
#
# Setup:
# 1. Go to https://console.cloud.google.com/ and create (or pick) a project.
# 2. APIs & Services → Library → enable "Places API (New)".
# 3. APIs & Services → Credentials → Create credentials → API key.
#    Restrict it to the "Places API (New)" and (recommended) to your server IP.
# 4. Find your Place ID with https://developers.google.com/maps/documentation/places/web-service/place-id
#    (search your business name; copy the "Place ID" string, e.g. ChIJ...).
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACE_ID=your_google_place_id

# ─────────────────────────────────────────────────────────────
# Email delivery (Google Workspace / Custom SMTP)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@groutix.com
SMTP_PASS=your_google_app_password
SMTP_FROM=info@groutix.com
SUPPORT_TO_EMAIL=info@groutix.com

# ─────────────────────────────────────────────────────────────
# Cloud photo storage (Cloudinary)
# ─────────────────────────────────────────────────────────────
# Customer quote attachments and CRM job photos are stored in Cloudinary
# so they load quickly via CDN, generate thumbnails, and don't bloat MongoDB.
# If these are left blank, photos fall back to Base64 in MongoDB.
# Setup:
# 1. Create a free account at https://cloudinary.com/
# 2. Go to Dashboard / API Keys → copy Cloud Name, API Key, and API Secret.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ─────────────────────────────────────────────────────────────
# CAPTCHA (optional)
# ─────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ─────────────────────────────────────────────────────────────
# Support chatbot (Claude)
# ─────────────────────────────────────────────────────────────
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# Admin panel + submission storage (MongoDB)
# ─────────────────────────────────────────────────────────────
# Quote requests and support tickets are stored in MongoDB so they can be
# browsed, analysed, and exported from the hidden admin panel. If MONGODB_URI
# is left blank, the public forms still work (email only) — nothing is stored.
#
# Setup:
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Database Access → add a user; Network Access → allow your host's IP
#    (or 0.0.0.0/0 for serverless like Vercel).
# 3. Connect → "Drivers" → copy the connection string into MONGODB_URI.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=groutix

# Admin login. Use a long, random password and session secret.
# Generate a secret with:  openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_long_password
ADMIN_SESSION_SECRET=change_this_to_a_long_random_string

# Optional: serve the admin panel from a hidden URL instead of /admin
# (e.g. /console-8f3a2b). Leave unset to use /admin.
# ADMIN_BASE_PATH=/admin

# ─────────────────────────────────────────────────────────────
# CRM staff logins (the four role accounts) + automations
# ─────────────────────────────────────────────────────────────
# Staff accounts live in MongoDB (admin_users collection) with roles:
#   intake | field | finance | manager
# The ADMIN_USERNAME/PASSWORD above stays as a manager-level break-glass login.
# Create the first manager account with:
#   node scripts/seed-user.mjs <username> <password> manager "Full Name"
# Managers can then add the rest from Admin → Staff Accounts.

# Scheduled follow-up sweep. Point an external scheduler (Vercel Cron,
# cron-job.org, GitHub Actions) at /api/cron/follow-ups once or twice a day
# with the header:  x-cron-secret: <CRON_SECRET>
CRON_SECRET=change_this_to_a_long_random_string
# Days to wait between quote follow-ups (default 2).
# FOLLOWUP_DAYS=2
