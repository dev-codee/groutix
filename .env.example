
# ─────────────────────────────────────────────────────────────
# Google reviews (Google Places API — New)
# ─────────────────────────────────────────────────────────────
# The testimonials sections pull live reviews from the GROUTIX Google Business
# Profile. If these are left blank, the site falls back to curated reviews.
#
# Setup:
# 1. Go to https://console.cloud.google.com/ and create (or pick) a project.
# 2. APIs & Services → Library → enable "Places API (New)".
# 3. APIs & Services → Credentials → Create credentials → API key.
#    Restrict it to the "Places API (New)" and (recommended) to your server IP.
# 4. Find your Place ID with https://developers.google.com/maps/documentation/places/web-service/place-id
#    (search your business name; copy the "Place ID" string, e.g. ChIJ...).
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACE_ID=your_google_place_id

# ─────────────────────────────────────────────────────────────
# Email delivery (Brevo)
# ─────────────────────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM=info@groutix.com
SUPPORT_TO_EMAIL=info@groutix.com

# ─────────────────────────────────────────────────────────────
# CAPTCHA (optional)
# ─────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ─────────────────────────────────────────────────────────────
# Support chatbot (Claude)
# ─────────────────────────────────────────────────────────────
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# Admin panel + submission storage (MongoDB)
# ─────────────────────────────────────────────────────────────
# Quote requests and support tickets are stored in MongoDB so they can be
# browsed, analysed, and exported from the hidden admin panel. If MONGODB_URI
# is left blank, the public forms still work (email only) — nothing is stored.
#
# Setup:
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Database Access → add a user; Network Access → allow your host's IP
#    (or 0.0.0.0/0 for serverless like Vercel).
# 3. Connect → "Drivers" → copy the connection string into MONGODB_URI.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=groutix

# Admin login. Use a long, random password and session secret.
# Generate a secret with:  openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=hehe
ADMIN_SESSION_SECRET=change_this_to_a_long_random_string

# Optional: serve the admin panel from a hidden URL instead of /admin
# (e.g. /console-8f3a2b). Leave unset to use /admin.
# ADMIN_BASE_PATH=/admin
